# Copier ce fichier en `.env.local` puis coller les 2 valeurs données par Supabase
# (Project Settings → API). Les deux sont PUBLIQUES par conception : elles vivent
# dans le code livré au navigateur.
#
# ⚠️ Ne JAMAIS mettre ici la clé `service_role` ni le mot de passe de la base :
# elles donnent un accès total et contournent toute la sécurité RLS.
#
# Tant que ces variables sont absentes, l'app tourne en mode 100 % local et
# empile ses modifications dans la file de synchro. Rien n'est perdu.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
